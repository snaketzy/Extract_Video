{
  "name": "extract-video",
  "version": "1.0.0",
  "private": true,
  "description": "基于 FFmpeg 的视频/音频/字幕轨道分离 Web 系统",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm --workspace server run dev",
    "dev:web": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "start": "npm --workspace server run start",
    "serve": "npm run build && npm run start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
